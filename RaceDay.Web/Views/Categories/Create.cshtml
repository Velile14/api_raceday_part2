@model RaceDay.Web.ViewModels.CategoryFormViewModel

@{
    ViewData["Title"] = "Create Category";
}

<div class="container mt-4">
    <h2>Create Event Category</h2>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="Category.EventID" class="form-label">
                Select Event
            </label>

            <select asp-for="Category.EventID"
                    class="form-select"
                    required>
                <option value="">-- Select an Event --</option>

                @foreach (var item in Model.Events)
                {
                    <option value="@item.EventID">
                        @item.EventName
                    </option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Category.CategoryName" class="form-label">
                Category Name
            </label>
            <input asp-for="Category.CategoryName"
                   class="form-control"
                   required />
        </div>

        <div class="mb-3">
            <label asp-for="Category.MinimumAge" class="form-label">
                Minimum Age
            </label>
            <input asp-for="Category.MinimumAge"
                   type="number"
                   min="0"
                   class="form-control"
                   required />
        </div>

        <div class="mb-3">
            <label asp-for="Category.MaximumAge" class="form-label">
                Maximum Age
            </label>
            <input asp-for="Category.MaximumAge"
                   type="number"
                   min="0"
                   class="form-control"
                   required />
        </div>

        <div class="mb-3">
            <label asp-for="Category.Distance" class="form-label">
                Distance (km)
            </label>
            <input asp-for="Category.Distance"
                   type="number"
                   step="0.01"
                   min="0"
                   class="form-control"
                   required />
        </div>

        <button type="submit" class="btn btn-success">
            Create Category
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>
